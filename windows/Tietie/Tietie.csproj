<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tietie</AssemblyName>
    <RootNamespace>Tietie</RootNamespace>
    <Version>0.4.0</Version>
    <Product>貼貼 Tietie</Product>
    <Company>奎嵐 KueiLan</Company>
    <Copyright>Copyright (c) 2026 奎嵐 KueiLan</Copyright>
    <Description>貼貼 Tietie</Description>
    <ApplicationIcon>Tietie.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.png" LogicalName="Tietie.icon.png" />
  </ItemGroup>

</Project>
